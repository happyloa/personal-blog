---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  variant: "desktop" | "mobile";
}

const { headings, variant } = Astro.props;
const filteredHeadings = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);
---

{filteredHeadings.length > 0 &&
  (variant === "desktop" ? (
    <aside class="toc-desktop">
      <nav class="toc-content" aria-label="本篇目錄">
        <p class="eyebrow" lang="en">
          ON THIS PAGE
        </p>
        <p class="toc-heading">本篇目錄</p>
        <ol>
          {filteredHeadings.map((heading) => (
            <li class:list={[{ "toc-nested": heading.depth === 3 }]}>
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-slug={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  ) : (
    <details class="toc-mobile">
      <summary>本篇目錄</summary>
      <nav aria-label="本篇目錄">
        <ol>
          {filteredHeadings.map((heading) => (
            <li class:list={[{ "toc-nested": heading.depth === 3 }]}>
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-slug={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ))}

<script>
  import { initTOC, cleanupTOC } from "../scripts/toc";
  document.addEventListener("astro:page-load", initTOC);
  document.addEventListener("astro:before-swap", cleanupTOC);
</script>
