---
import { categories } from "../utils/categories";
interface Category {
  slug: string;
  name: string;
  description: string;
  icon: string;
}

interface Props {
  category: Category;
  count: number;
  headingLevel?: "h2" | "h3";
}

const { category, count, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const number = String(
  categories.findIndex((item) => item.slug === category.slug) + 1,
).padStart(2, "0");
---

<a href={`/categories/${category.slug}/`} class="topic-card">
  <div class="topic-meta">
    <span lang="en">
      {number} / {category.slug}
    </span>
    <span>{count} 篇</span>
  </div>
  <Heading>
    {category.name}
    <span aria-hidden="true">↗</span>
  </Heading>
  <p>{category.description}</p>
</a>
