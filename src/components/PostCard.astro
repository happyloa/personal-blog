---
import type { CollectionEntry } from "astro:content";
import { toPlainTextExcerpt } from "../utils/summary";
import { getPostDescription } from "../utils/posts";
import { formatDate, toISODate } from "../utils/date";

interface Props {
  post: CollectionEntry<"posts">;
  headingLevel?: "h2" | "h3";
}

// 卡片標題的層級由呼叫端決定：首頁與列表頁的卡片是「最新文章」這類區塊的下一層，
// 應為 h3，否則整頁大綱會變成一長串同級 h2。
const { post, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const formattedDate = formatDate(post.data.date);
const isoDate = toISODate(post.data.date);
const summary = toPlainTextExcerpt(getPostDescription(post));
---

<article class="surface surface-hover group p-5 md:p-6">
  <div class="mb-4 flex flex-wrap items-center gap-2 text-xs text-slate-400">
    <time datetime={isoDate} class="font-mono">
      {formattedDate}
    </time>
    {post.data.tags.slice(0, 3).map((tag) => (
      <span class="tag-pill px-2 py-0.5 text-2xs">#{tag}</span>
    ))}
  </div>

  <Heading class="mb-3 text-xl leading-snug md:text-2xl">
    <a
      href={`/posts/${post.id}/`}
      class="text-slate-50 no-underline group-hover:text-primary-muted"
      data-astro-prefetch="hover"
    >
      {post.data.title}
    </a>
  </Heading>

  {summary && (
    <p class="mb-5 line-clamp-3 text-sm leading-7 text-slate-400">{summary}</p>
  )}

  <a
    href={`/posts/${post.id}/`}
    class="inline-flex items-center gap-2 text-sm font-medium no-underline"
    aria-label={`閱讀文章：${post.data.title}`}
  >
    閱讀文章
    <span aria-hidden="true">→</span>
  </a>
</article>
