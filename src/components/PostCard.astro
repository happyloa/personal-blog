---
import type { CollectionEntry } from "astro:content";
import { toPlainTextExcerpt } from "../utils/summary";
import { getPostDescription } from "../utils/posts";
import { formatDate, toISODate } from "../utils/date";
import { getCategoryBySlug } from "../utils/categories";

interface Props {
  post: CollectionEntry<"posts">;
  headingLevel?: "h2" | "h3";
  index?: number;
}

// 卡片標題的層級由呼叫端決定：首頁的卡片位於「最新文章」h2 之下，要傳入 h3；
// 文章列表與分類頁的卡片直接接在 h1 之下，使用預設的 h2。
const { post, headingLevel = "h2", index } = Astro.props;
const Heading = headingLevel;
const formattedDate = formatDate(post.data.date);
const isoDate = toISODate(post.data.date);
const summary = toPlainTextExcerpt(getPostDescription(post));
const category = getCategoryBySlug(post.data.category);
---

<article class="post-row" data-post-id={post.id}>
  <div class="post-meta">
    {index !== undefined && (
      <span class="post-number" aria-hidden="true">
        {String(index).padStart(2, "0")}
      </span>
    )}
    <time datetime={isoDate}>{formattedDate}</time>
    <span class="post-category">{category?.name}</span>
  </div>
  <div class="post-copy">
    <Heading>
      <a
        href={`/posts/${post.id}/`}
        class="post-title"
        data-astro-prefetch="hover"
      >
        {post.data.title}
      </a>
    </Heading>
    {summary && <p class="post-summary">{summary}</p>}
  </div>
  <span class="post-arrow" aria-hidden="true">
    ↗
  </span>
</article>
