---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { navLinks, site, toJsonLd } from "../utils/site";
import "../styles/global.css";

const {
  title = site.title,
  description = site.description,
  image = site.defaultOgImage,
  imageWidth = 1200,
  imageHeight = 630,
  ogType = "website",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  noindex = false,
} = Astro.props;

const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;

// 主導覽的 active 判定：首頁只在完全相符時算命中，其餘用前綴比對，
// 讓分類內頁也能正確標示所屬區塊。
const isCurrentNav = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

// 全站身分識別。文章頁另有各自的 BlogPosting（見 posts/[slug].astro），兩者並存是合法的。
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      url: new URL("/", Astro.site).href,
      name: site.title,
      description: site.description,
      inLanguage: "zh-Hant-TW",
      publisher: { "@id": new URL("/#person", Astro.site).href },
    },
    {
      "@type": "Person",
      "@id": new URL("/#person", Astro.site).href,
      name: site.author,
      url: new URL("/", Astro.site).href,
      sameAs: [site.githubUrl, site.cakeUrl],
    },
  ],
};
---

<!doctype html>
<html lang="zh-Hant" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    {/* Inter 是內文字型，值得 preload；astro.config.mjs 已限定 styles: ["normal"]，
        因此不會連帶把用不到的斜體檔案拉到最高優先級。 */}
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-outfit" />
    <Font cssVariable="--font-jetbrains" />

    {/* 中文字型的 CSS 與字型檔較大，先以系統字型顯示內容，載入完成再套用。
        由外部模組設定 media，避免 inline onload 違反站台 CSP。 */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      id="cjk-fonts"
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap"
      media="print"
      transition:persist
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap"
      />
    </noscript>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#181917" />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="/favicon.svg?v=journal-1"
    />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />
    <meta name="twitter:image:alt" content={title} />

    <script
      type="application/ld+json"
      set:html={toJsonLd(siteJsonLd)}
      is:inline
    ></script>
    <slot name="head" />

    <ClientRouter />
  </head>
  <body id="top" class="min-h-screen">
    <a class="skip-link" href="#main-content">
      跳到主要內容
    </a>

    <header class="site-header">
      <div class="site-container header-inner">
        <a href="/" class="wordmark" aria-label={`${site.name} 首頁`}>
          <span class="wordmark-symbol" aria-hidden="true">
            a<span class="text-primary">.</span>
          </span>
          <span class="wordmark-label" lang="en">
            AARON /<br />
            JOURNAL
          </span>
        </a>

        <nav class="primary-nav" aria-label="主要導覽">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrentNav(link.href) ? "page" : undefined}
              class="nav-link"
            >
              {link.label}
            </a>
          ))}
          <a
            class="nav-link"
            href={site.portfolioUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            作品集 <span aria-hidden="true">↗</span>
            <span class="sr-only">（另開新分頁）</span>
          </a>
        </nav>
      </div>
    </header>

    <slot name="reading-progress" />

    <main id="main-content" class="site-container site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-container">
        <div class="footer-main">
          <div>
            <p class="footer-signature" lang="en">
              Aaron Hsieh<span class="text-primary">.</span>
            </p>
            <p class="text-sm text-muted">設計的眼光，工程的思維。</p>
          </div>
          <nav class="footer-links" aria-label="頁尾連結">
            <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">
              GitHub ↗<span class="sr-only">（另開新分頁）</span>
            </a>
            <a
              href={site.portfolioUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              作品集 ↗<span class="sr-only">（另開新分頁）</span>
            </a>
            <a href="/rss.xml">RSS 訂閱 ↗</a>
            <a href="#top">回到頂端 ↑</a>
          </nav>
        </div>
        <div class="footer-colophon">
          <span>
            © {currentYear} {site.name}.
          </span>
          <span lang="en">Built with Astro &amp; Tailwind CSS.</span>
        </div>
      </div>
    </footer>

    <script>
      import { initMermaid, cleanupMermaid } from "../scripts/mermaid";
      import { initFonts } from "../scripts/fonts";

      document.addEventListener("astro:page-load", () => {
        initFonts();
        initMermaid();
      });

      document.addEventListener("astro:before-swap", cleanupMermaid);
    </script>
  </body>
</html>
