---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { navLinks, site, toJsonLd } from "../utils/site";
import "../styles/global.css";

const {
  title = site.title,
  description = site.description,
  image = site.defaultOgImage,
  imageWidth = 1200,
  imageHeight = 630,
  ogType = "website",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  noindex = false,
} = Astro.props;

const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;

// 主導覽的 active 判定：首頁只在完全相符時算命中，其餘用前綴比對，
// 讓 /tags/vue/ 這類子頁也能正確標示所屬區塊。
const isCurrentNav = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

// 全站身分識別。文章頁另有各自的 BlogPosting（見 posts/[slug].astro），兩者並存是合法的。
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      url: new URL("/", Astro.site).href,
      name: site.title,
      description: site.description,
      inLanguage: "zh-Hant-TW",
      publisher: { "@id": new URL("/#person", Astro.site).href },
    },
    {
      "@type": "Person",
      "@id": new URL("/#person", Astro.site).href,
      name: site.author,
      url: new URL("/", Astro.site).href,
      sameAs: [site.githubUrl, site.cakeUrl],
    },
  ],
};
---

<!doctype html>
<html lang="zh-Hant" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    {/* Inter 是內文字型，值得 preload；astro.config.mjs 已限定 styles: ["normal"]，
        因此不會連帶把用不到的斜體檔案拉到最高優先級。 */}
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-outfit" />
    <Font cssVariable="--font-jetbrains" />

    {/* 只取 400／700 兩個字重：500 僅用於導覽列與小字級 UI，14px 下與 400 幾乎無差異，
        但整份 CSS 的傳輸量可因此減少約三分之一。 */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />
    <meta name="twitter:image:alt" content={title} />

    <script
      type="application/ld+json"
      set:html={toJsonLd(siteJsonLd)}
      is:inline
    ></script>
    <slot name="head" />

    <ClientRouter />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <canvas
      id="grid-glow-canvas"
      class="pointer-events-none fixed inset-0 z-0 h-full w-full"
      aria-hidden="true"
    ></canvas>

    <a class="skip-link" href="#main-content">
      跳到主要內容
    </a>

    <header class="sticky top-0 z-40 border-b border-border-soft bg-base/90 backdrop-blur">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a
          href="/"
          class="flex items-center gap-3 no-underline"
          aria-label={`${site.name} 首頁`}
        >
          <span class="flex size-9 items-center justify-center rounded-md border border-border-soft bg-surface font-display text-base font-semibold text-slate-50">
            {site.name.charAt(0)}
          </span>
          <span class="hidden font-display text-base font-semibold text-slate-50 sm:inline">
            {site.name}
          </span>
        </a>

        <nav class="flex items-center gap-1" aria-label="主要導覽">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrentNav(link.href) ? "page" : undefined}
              class="rounded-md px-3 py-2 text-sm font-medium text-slate-400 no-underline hover:bg-surface hover:text-slate-50 aria-current:bg-surface aria-current:text-slate-50"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main
      id="main-content"
      class="relative z-10 mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 lg:py-16"
      tabindex="-1"
    >
      <slot />
    </main>

    <footer class="relative z-10 mt-16 border-t border-border-soft bg-base">
      <div class="mx-auto grid w-full max-w-5xl gap-10 px-4 py-10 sm:px-6 md:footer-columns">
        <section>
          <div class="mb-3 flex items-center gap-3">
            <span class="flex size-9 items-center justify-center rounded-md border border-border-soft bg-surface font-display font-semibold text-slate-50">
              {site.name.charAt(0)}
            </span>
            <h2 class="text-lg">{site.name}</h2>
          </div>
          <p class="max-w-sm text-sm leading-6 text-slate-400">
            記錄前端工程、網站效能、專案實作與職涯思考的個人技術筆記。
          </p>
        </section>

        <nav aria-label="頁尾導覽">
          <h2 class="mb-3 text-sm font-semibold text-slate-200">導覽</h2>
          <ul class="grid gap-2 text-sm">
            {navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-slate-400 no-underline">
                  {link.label}
                </a>
              </li>
            ))}
            <li>
              <a href="/rss.xml" class="text-slate-400 no-underline">
                RSS 訂閱
              </a>
            </li>
          </ul>
        </nav>

        <section>
          <h2 class="mb-3 text-sm font-semibold text-slate-200">連結</h2>
          <ul class="grid gap-2 text-sm">
            <li>
              <a
                href={site.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-400 no-underline"
              >
                GitHub
              </a>
            </li>
            <li>
              <a
                href={site.cakeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-400 no-underline"
              >
                Cake
              </a>
            </li>
          </ul>
        </section>
      </div>

      <div class="border-t border-border-soft px-4 py-5 text-center text-xs text-slate-400">
        © {currentYear}
        {site.name}. <span lang="en">Built with Astro and Tailwind CSS.</span>
      </div>
    </footer>

    <script>
      import { initMermaid } from "../scripts/mermaid";
      import { initGridGlow, cleanupGridGlow } from "../scripts/grid-glow";

      document.addEventListener("astro:page-load", () => {
        initMermaid();
        initGridGlow();
      });

      document.addEventListener("astro:before-swap", cleanupGridGlow);
    </script>
  </body>
</html>
