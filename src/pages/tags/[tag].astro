---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPostsSorted } from "../../utils/posts";
import { site } from "../../utils/site";
import { getPostsByTag } from "../../utils/tags";

interface Props {
  displayTag: string;
  posts: CollectionEntry<"posts">[];
}

export async function getStaticPaths() {
  const allPosts = await getPublishedPostsSorted();
  const byTag = getPostsByTag(allPosts);

  return Array.from(byTag.values()).map((data) => ({
    params: { tag: data.slug },
    props: { displayTag: data.display, posts: data.posts },
  }));
}

const { displayTag, posts } = Astro.props;
---

<BaseLayout
  title={`#${displayTag} 標籤文章｜${site.title}`}
  description={`包含 #${displayTag} 標籤的文章彙整`}
  noindex={posts.length < 2}
>
  <section class="mb-10 max-w-3xl">
    <a href="/tags/" class="mb-5 inline-flex text-sm no-underline">
      ← 返回標籤
    </a>
    <p class="eyebrow mb-3" lang="en">
      Tag
    </p>
    <h1 class="mb-4 text-3xl md:text-4xl">#{displayTag}</h1>
    <p class="font-mono text-xs text-slate-400">共 {posts.length} 篇文章</p>
  </section>

  <section class="grid gap-4">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </section>
</BaseLayout>
