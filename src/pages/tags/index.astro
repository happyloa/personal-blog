---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPostsSorted } from "../../utils/posts";
import { site } from "../../utils/site";
import { getAllTags } from "../../utils/tags";

const posts = await getPublishedPostsSorted();
const tags = getAllTags(posts);
---

<BaseLayout
  title={`所有標籤｜${site.title}`}
  description="瀏覽部落格使用中的所有標籤與文章數量"
>
  <section class="mb-10 max-w-3xl">
    <a href="/" class="mb-5 inline-flex text-sm no-underline">
      ← 返回首頁
    </a>
    <p class="eyebrow mb-3" lang="en">
      Tags
    </p>
    <h1 class="mb-4 text-3xl md:text-4xl">標籤索引</h1>
    <p class="leading-8 text-slate-400">
      快速查看目前文章使用的標籤，以及每個標籤底下的文章數量。
    </p>
  </section>

  <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {tags.length === 0 ? (
      <p class="surface p-5 text-slate-400">目前還沒有任何標籤。</p>
    ) : (
      tags.map((tag) => (
        <a
          href={`/tags/${tag.slug}/`}
          class="surface surface-hover flex items-center justify-between gap-4 p-4 no-underline"
          aria-label={`查看 #${tag.display} 標籤的 ${tag.count} 篇文章`}
        >
          <span class="tag-pill">#{tag.display}</span>
          <span class="font-mono text-xs text-slate-400">{tag.count} 篇</span>
        </a>
      ))
    )}
  </section>
</BaseLayout>
