---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../utils/site";
---

<BaseLayout
  title={`找不到頁面｜${site.title}`}
  description="這個頁面不存在或已被移除。"
  noindex
>
  <section class="error-page page-heading">
    <p class="eyebrow" lang="en">
      404 / PAGE NOT FOUND
    </p>
    <h1>
      這一頁，還是空白<span class="text-primary">。</span>
    </h1>
    <p>找不到你要看的頁面。可以回到首頁，或從文章列表繼續閱讀。</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="text-link">
        ← 返回首頁
      </a>
      <a href="/posts/" class="button-primary">
        所有文章 ↗
      </a>
    </div>
  </section>
</BaseLayout>
