---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import { categories, getCategoryCounts } from "../utils/categories";
import { getPublishedPostsSorted } from "../utils/posts";
import { site } from "../utils/site";

const posts = await getPublishedPostsSorted();
const categoryCounts = getCategoryCounts(posts);
// 首頁只列出真的有文章的分類，避免新增分類後、還沒寫文章前就出現「◯◯ · 0 篇」的空卡片。
const visibleCategories = categories.filter(
  (category) => (categoryCounts.get(category.slug) || 0) > 0,
);
---

<BaseLayout title={site.title} description={site.description}>
  <div class="grid gap-16">
    <section class="max-w-3xl">
      <p class="eyebrow mb-5" lang="en">
        Frontend / Web / Notes
      </p>
      <h1 class="mb-6 text-4xl leading-tight md:text-6xl">
        寫下前端開發、網站架構與學習路上的實作筆記。
      </h1>
      <p class="max-w-2xl text-lg leading-8 text-slate-400">
        這裡整理我在專案開發中踩過的坑，與職涯上的一些心得。
        <br />
        內容以實務經驗為主，也保留一些學習過程中的反思。
      </p>
    </section>

    <section>
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-2" lang="en">
            Categories
          </p>
          <h2 class="text-2xl">文章分類</h2>
        </div>
        <a href="/categories/" class="text-sm font-medium no-underline">
          查看全部 →
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {visibleCategories.map((category) => (
          <CategoryCard
            category={category}
            count={categoryCounts.get(category.slug) || 0}
            headingLevel="h3"
          />
        ))}
      </div>
    </section>

    <section>
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="eyebrow mb-2" lang="en">
            Latest
          </p>
          <h2 class="text-2xl">最新文章</h2>
        </div>
        <a href="/rss.xml" class="text-sm font-medium no-underline">
          RSS 訂閱 →
        </a>
      </div>

      <div class="grid gap-4">
        {posts.map((post) => (
          <PostCard post={post} headingLevel="h3" />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
