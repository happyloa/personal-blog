---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import EditorialHero from "../components/EditorialHero.astro";
import { categories, getCategoryCounts } from "../utils/categories";
import { getPublishedPostsSorted } from "../utils/posts";
import { site } from "../utils/site";

const posts = await getPublishedPostsSorted();
const categoryCounts = getCategoryCounts(posts);
// 首頁只列出真的有文章的分類，避免新增分類後、還沒寫文章前就出現「◯◯ · 0 篇」的空卡片。
const visibleCategories = categories.filter(
  (category) => (categoryCounts.get(category.slug) || 0) > 0,
);
---

<BaseLayout title={site.title} description={site.description}>
  <div class="home-sections">
    <EditorialHero />

    <section aria-labelledby="latest-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow" lang="en">
            01 / LATEST WRITING
          </p>
          <h2 id="latest-heading">
            最新文章<span class="text-primary">.</span>
          </h2>
        </div>
        <a href="/posts/" class="text-link">
          所有文章（{posts.length}）<span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="post-list">
        {posts.slice(0, 6).map((post, index) => (
          <PostCard post={post} headingLevel="h3" index={index + 1} />
        ))}
      </div>
    </section>

    <section aria-labelledby="topics-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow" lang="en">
            02 / EXPLORE TOPICS
          </p>
          <h2 id="topics-heading">
            依主題探索<span class="text-primary">.</span>
          </h2>
        </div>
        <a href="/categories/" class="text-link">
          所有分類 <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="topic-grid">
        {visibleCategories.map((category) => (
          <CategoryCard
            category={category}
            count={categoryCounts.get(category.slug) || 0}
            headingLevel="h3"
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
