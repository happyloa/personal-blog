---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import { categories, getCategoryCounts } from "../../utils/categories";
import { getPublishedPostsSorted } from "../../utils/posts";
import { site } from "../../utils/site";

const posts = await getPublishedPostsSorted();
const categoryCounts = getCategoryCounts(posts);
---

<BaseLayout
  title={`文章分類｜${site.title}`}
  description="依照主題分類瀏覽所有文章"
>
  <header class="page-heading">
    <p class="eyebrow" lang="en">
      02 / TOPICS
    </p>
    <h1>
      文章分類<span class="text-primary">.</span>
    </h1>
    <p>選擇你有興趣的主題，從一組相關文章開始讀。</p>
  </header>

  <section class="topic-grid" aria-label="所有分類">
    {categories.map((category) => (
      <CategoryCard
        category={category}
        count={categoryCounts.get(category.slug) || 0}
        headingLevel="h2"
      />
    ))}
  </section>
</BaseLayout>
