---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import { categories, getCategoryCounts } from "../../utils/categories";
import { getPublishedPostsSorted } from "../../utils/posts";
import { site } from "../../utils/site";

const posts = await getPublishedPostsSorted();
const categoryCounts = getCategoryCounts(posts);
---

<BaseLayout
  title={`文章分類｜${site.title}`}
  description="依照主題分類瀏覽所有文章"
>
  <section class="mb-10 max-w-3xl">
    <a href="/" class="mb-5 inline-flex text-sm no-underline">
      ← 返回首頁
    </a>
    <p class="eyebrow mb-3" lang="en">
      Categories
    </p>
    <h1 class="mb-4 text-3xl md:text-4xl">文章分類</h1>
    <p class="leading-8 text-slate-400">
      選擇你有興趣的主題，從一組相關文章開始讀。
    </p>
  </section>

  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {categories.map((category) => (
      <CategoryCard
        category={category}
        count={categoryCounts.get(category.slug) || 0}
        headingLevel="h2"
      />
    ))}
  </section>
</BaseLayout>
