---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { categories } from "../../utils/categories";
import { getPublishedPostsSorted } from "../../utils/posts";
import { site } from "../../utils/site";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { categoryInfo: category },
  }));
}

const { categoryInfo } = Astro.props;
const categorySlug = categoryInfo.slug;

const allPosts = await getPublishedPostsSorted();
const posts = allPosts.filter((post) => post.data.category === categorySlug);
---

<BaseLayout
  title={`${categoryInfo.name}｜${site.title}`}
  description={categoryInfo.description}
  noindex={posts.length < 2}
>
  <header class="page-heading">
    <a href="/categories/" class="text-link mb-6">
      ← 返回分類
    </a>
    <p class="eyebrow" lang="en">
      02 / {categorySlug}
    </p>
    <h1>
      {categoryInfo.name}
      <span class="text-primary">.</span>
    </h1>
    <p>{categoryInfo.description}</p>
    <p class="archive-count">共 {posts.length} 篇文章</p>
  </header>

  <section class="post-list" aria-label={`${categoryInfo.name}文章`}>
    {posts.length > 0 ? (
      posts.map((post) => <PostCard post={post} />)
    ) : (
      <div class="empty-state">
        <p>這個分類目前還沒有文章。</p>
        <a href="/posts/" class="text-link">
          瀏覽所有文章 →
        </a>
      </div>
    )}
  </section>
</BaseLayout>
