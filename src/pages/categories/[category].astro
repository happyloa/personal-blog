---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { categories } from "../../utils/categories";
import { getPublishedPostsSorted } from "../../utils/posts";
import { site } from "../../utils/site";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { categoryInfo: category },
  }));
}

const { categoryInfo } = Astro.props;
const categorySlug = categoryInfo.slug;

const allPosts = await getPublishedPostsSorted();
const posts = allPosts.filter((post) => post.data.category === categorySlug);
---

<BaseLayout
  title={`${categoryInfo.name}｜${site.title}`}
  description={categoryInfo.description}
  noindex={posts.length < 2}
>
  <section class="mb-10 max-w-3xl">
    <a href="/categories/" class="mb-5 inline-flex text-sm no-underline">
      ← 返回分類
    </a>
    <p class="eyebrow mb-3" lang="en">
      Category
    </p>
    <h1 class="mb-4 flex items-center gap-3 text-3xl md:text-4xl">
      <span aria-hidden="true">{categoryInfo.icon}</span>
      {categoryInfo.name}
    </h1>
    <p class="leading-8 text-slate-400">{categoryInfo.description}</p>
    <p class="mt-3 font-mono text-xs text-slate-400">
      共 {posts.length} 篇文章
    </p>
  </section>

  <section class="grid gap-4">
    {posts.length > 0 ? (
      posts.map((post) => <PostCard post={post} />)
    ) : (
      <p class="surface p-5 text-slate-400">這個分類目前還沒有文章。</p>
    )}
  </section>
</BaseLayout>
