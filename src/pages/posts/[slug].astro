---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import {
  calculateReadingTime,
  getPostDescription,
  getPublishedPostsSorted,
} from "../../utils/posts";
import { site, toJsonLd } from "../../utils/site";
import { formatDate, toISODate } from "../../utils/date";
import { getCategoryBySlug } from "../../utils/categories";
import { toPlainTextExcerpt } from "../../utils/summary";

export async function getStaticPaths() {
  const posts = await getPublishedPostsSorted();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = calculateReadingTime(post.body ?? "");
const formattedDate = formatDate(post.data.date);
const isoDate = toISODate(post.data.date);
// 有填 updated 就以它為修訂時間，否則等同發布時間。
const isoUpdated = toISODate(post.data.updated ?? post.data.date);
const hasUpdate = isoUpdated !== isoDate;

const category = getCategoryBySlug(post.data.category);
const categoryURL = new URL(`/categories/${post.data.category}/`, Astro.site);

const description = toPlainTextExcerpt(getPostDescription(post));
const canonicalURL = new URL(`/posts/${post.id}/`, Astro.site);
const ogImage = post.data.cover?.src ?? site.defaultOgImage;
const ogImageURL = new URL(ogImage, Astro.site);

// 結構化資料：讓搜尋引擎與社群將文章辨識為 Article 而非一般網頁。
// author 指回 BaseLayout 站台 @graph 裡的同一個 Person，避免出現兩個身分。
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  datePublished: isoDate,
  dateModified: isoUpdated,
  inLanguage: "zh-Hant-TW",
  author: { "@id": new URL("/#person", Astro.site).href },
  publisher: { "@id": new URL("/#person", Astro.site).href },
  image: ogImageURL.href,
  mainEntityOfPage: canonicalURL.href,
  ...(category && { articleSection: category.name }),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: new URL("/", Astro.site).href,
    },
    ...(category
      ? [
          {
            "@type": "ListItem",
            position: 2,
            name: category.name,
            item: categoryURL.href,
          },
        ]
      : []),
    {
      "@type": "ListItem",
      position: category ? 3 : 2,
      name: post.data.title,
      item: canonicalURL.href,
    },
  ],
};
---

<BaseLayout
  title={`${post.data.title}｜${site.title}`}
  description={description}
  image={ogImage}
  imageWidth={post.data.cover?.width ?? 1200}
  imageHeight={post.data.cover?.height ?? 630}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate} />
    {hasUpdate && (
      <meta property="article:modified_time" content={isoUpdated} />
    )}
    <meta property="article:author" content={site.author} />
    {category && <meta property="article:section" content={category.name} />}
    <script
      is:inline
      type="application/ld+json"
      set:html={toJsonLd(blogPostingSchema)}
    ></script>
    <script
      is:inline
      type="application/ld+json"
      set:html={toJsonLd(breadcrumbSchema)}
    ></script>
  </Fragment>

  <nav
    class="mb-8 flex min-w-0 flex-wrap items-center gap-2 text-sm text-slate-400"
    aria-label="麵包屑"
  >
    <a href="/" class="shrink-0 no-underline">
      首頁
    </a>
    <span aria-hidden="true">/</span>
    {category && (
      <>
        <a
          href={`/categories/${post.data.category}/`}
          class="shrink-0 no-underline"
        >
          {category.name}
        </a>
        <span aria-hidden="true">/</span>
      </>
    )}
    <span class="min-w-0 truncate text-slate-300">{post.data.title}</span>
  </nav>

  <article class="prose prose-lg prose-a:break-all">
    <header class="not-prose mb-12 border-b border-border-soft pb-8">
      <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-400">
        <time datetime={isoDate}>{formattedDate}</time>
        {hasUpdate && (
          <span>
            更新於 <time datetime={isoUpdated}>{formatDate(isoUpdated)}</time>
          </span>
        )}
        <span>約 {readingTime} 分鐘閱讀</span>
      </div>

      <h1 class="mb-6 text-3xl leading-tight md:text-5xl">{post.data.title}</h1>
    </header>

    <Content />
  </article>

  <TableOfContents headings={headings} />
</BaseLayout>
